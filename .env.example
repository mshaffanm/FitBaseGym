# GEMINI_API_KEY: Required for Gemini AI API calls (FitBase AI Concierge).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Required for real-world Auth & PostgreSQL Database)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional browser-prefixed Supabase keys (falls back to SUPABASE_URL / SUPABASE_ANON_KEY if omitted)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Security secrets for hardware biometric HMAC hashing & turnstile daemon pushes
BIOMETRIC_SALT="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_SECRET"
HARDWARE_AGENT_KEY=""

# Optional WhatsApp Cloud API / Webhook credentials for automated renewal reminders
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_URL=""
